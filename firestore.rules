rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && (userRecord().admin == 1 || userRecord().role == "admin");
    }
    match /properties/{propertyId} {
      allow get: if resource.data.status == "approved" ||
        (signedIn() && resource.data.brokerId == request.auth.uid) || isAdmin();
      allow list: if resource.data.status == "approved" || isAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
