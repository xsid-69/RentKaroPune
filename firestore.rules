rules_version = '2';

// All RentKaroPune data access goes through the server-side Firebase Admin SDK,
// which bypasses these rules. No browser client should ever read or write
// Firestore directly, so we deny every client request.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
