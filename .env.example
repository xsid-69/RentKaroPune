# Leave both values empty to use the built-in Pune location dataset.
# Setting either key enables debounced Google Places suggestions.
# GOOGLE_PLACES_API_KEY is preferred because it stays server-side.
GOOGLE_PLACES_API_KEY=

# Supported for deployments that already use this variable name.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Firebase Web app config for Google sign-in.
# Copy these into .env.local and fill with your project's values.
# Console: Project settings > General > Your apps > Web app > Config.
# These are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side secrets for email/phone + password (JWT) auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Firebase Admin SDK service account JSON (single line) for Firestore user storage.
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Only needed if your Firestore database has a custom id (not the default "(default)").
FIRESTORE_DATABASE_ID=
